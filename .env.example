# Copia este archivo a .env y reemplaza el valor.
# El salt real se comparte SOLO por un canal privado del grupo (nunca Drive público ni git):
# si se filtra, cualquiera puede revertir la seudonimización por fuerza bruta.
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
ANON_SALT=reemplazar_por_salt_secreto

# --- Google Drive (rclone) ---
# Nombre del remoto creado con `rclone config` y carpeta del grupo dentro de él.
# Lo usa scripts/sync_drive.sh. No es secreto, pero es propio de cada máquina.
DRIVE_REMOTE=drive
DRIVE_FOLDER=AnonLogs
