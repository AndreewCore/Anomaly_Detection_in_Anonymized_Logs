# Escenario concentrado: 1 IP -> 1 cuenta. Usado con lab/capture.sh (que pasa
# este archivo como --env-file y activa el perfil del mismo nombre).
PROFILE=concentrado
SEGMENT_MINUTES=30
SEGMENTS=3
BURSTS_PER_SEGMENT=2
SEED_BASE=1000
PAUSE_MS=800
LEGIT_PASSWORD=clave_lab_legitima
# attacker_1: una sola cuenta, muchas claves
A1_USERS=admin
A1_N=50
