# Escenario multi_cuenta: 1 IP -> N cuentas.
PROFILE=multi_cuenta
SEGMENT_MINUTES=30
SEGMENTS=3
BURSTS_PER_SEGMENT=2
SEED_BASE=2000
PAUSE_MS=800
LEGIT_PASSWORD=clave_lab_legitima
# attacker_1 contra varias cuentas comunes, pocas claves por cuenta
A1_USERS=admin,root,test,guest,user1,administrator
A1_N=10
